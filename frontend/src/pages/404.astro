---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Página no encontrada | Xperience">
    <section
        class="section-full relative justify-center overflow-hidden bg-background text-foreground fade-on-scroll"
    >
        <div
            class="absolute -top-24 left-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-primary/10 blur-3xl pointer-events-none"
        >
        </div>

        <div
            class="wrapper relative z-10 flex flex-col items-center text-center"
        >
            <div class="relative">
                <span
                    class="font-display text-[8rem] font-black leading-none text-primary/15 sm:text-[12rem] md:text-[14rem] select-none"
                >
                    404
                </span>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 font-display text-xs font-semibold text-primary shadow-sm backdrop-blur-md"
                    >
                        Ruta no encontrada
                    </span>
                </div>
            </div>

            <h1
                class="-mt-4 max-w-2xl font-display text-3xl font-extrabold tracking-tight sm:text-5xl md:text-6xl"
            >
                Parece que te saliste del camino.
            </h1>

            <p
                class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base font-sans"
            >
                La página que buscas no existe, fue movida o temporalmente no
                está disponible.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <Button href="/" variant="primary" size="lg">
                    <span>&larr; Volver al inicio</span>
                </Button>

                <Button href="/#reservar" variant="secondary" size="lg">
                    <span>Agendar cita</span>
                </Button>
            </div>
        </div>
    </section>
</Layout>
