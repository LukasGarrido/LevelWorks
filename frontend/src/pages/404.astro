---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Página no encontrada">
    <section
        class="section-full justify-center bg-background text-foreground fade-on-scroll"
    >
        <div class="wrapper flex flex-col items-center text-center">
            <span
                class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 font-display text-sm font-semibold text-primary shadow-sm"
            >
                Error 404
            </span>

            <!-- Título principal -->
            <h1
                class="mt-6 max-w-2xl font-display text-5xl font-extrabold tracking-tight sm:text-6xl md:text-7xl"
            >
                Parece que te saliste del camino.
            </h1>

            <p
                class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg font-sans"
            >
                La página que estás buscando no existe, fue movida o cambió de
                dirección.
            </p>

            <div class="mt-8 flex items-center justify-center">
                <Button href="/" variant="primary" size="lg">
                    &larr; Volver al inicio
                </Button>
            </div>
        </div>
    </section>
</Layout>
