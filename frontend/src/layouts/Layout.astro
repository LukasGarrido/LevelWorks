---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "LevelWorks — Tu auto impecable, sin filas ni esperas",
	description = "Reserva tu servicio de lavado y detallado automotriz de forma rápida y sin esperas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Google Fonts: DM Sans & Space Grotesk -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Space+Grotesk:wght@300..700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />

		<!-- Script para animaciones al hacer scroll -->
		<script>
			const observerOptions = {
				root: null,
				rootMargin: "0px",
				threshold: 0.1,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
					}
				});
			}, observerOptions);

			document.addEventListener("DOMContentLoaded", () => {
				const animatedElements =
					document.querySelectorAll(".fade-on-scroll");
				animatedElements.forEach((el) => observer.observe(el));
			});
		</script>
	</body>
</html>
