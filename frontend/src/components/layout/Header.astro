---
// src/components/layout/Header.astro
import Button from "../ui/Button.astro";

const navItems = [
    { label: "Servicios", href: "/#servicios" },
    { label: "Cómo funciona", href: "/#como-funciona" },
    { label: "Reservar", href: "/#reservar" },
];
---

<header
    class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-colors duration-300"
>
    <div class="wrapper flex items-center justify-between py-4">
        <a
            href="/"
            class="font-display text-xl font-bold tracking-tight text-foreground"
        >
            LevelWorks<span class="text-primary">.</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 mx-auto">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="text-sm font-medium text-muted-foreground transition hover:text-foreground"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-3">
            <Button href="/admin" variant="ghost" size="sm">
                Acceso Admin
            </Button>
        </div>
    </div>
</header>
