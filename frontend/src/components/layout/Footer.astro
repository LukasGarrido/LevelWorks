---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background py-10">
    <div class="wrapper text-sm text-muted-foreground">
        <div
            class="flex flex-col items-center justify-between gap-4 md:flex-row"
        >
            <p>© {year} LevelWorks. Todos los derechos reservados.</p>
            <div class="flex items-center gap-5">
                <!-- Ícono de Correo / Contacto -->
                <a
                    href="mailto:contacto@levelworks.cl"
                    aria-label="Contacto por email"
                    class="hover:text-foreground transition-colors p-1"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                        ></path>
                    </svg>
                </a>

                <!-- Ícono de Instagram -->
                <a
                    href="https://instagram.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Perfil de Instagram"
                    class="hover:text-foreground transition-colors p-1"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"
                        ></rect>
                        <path
                            d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                        ></path>
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>
