---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background py-10">
    <div class="wrapper text-sm text-muted-foreground">
        <div
            class="flex flex-col items-center justify-between gap-4 md:flex-row"
        >
            <p>© {year} Xperience. Todos los derechos reservados.</p>
            <div class="flex gap-6">
                <a
                    href="mailto:contacto@xperience.cl"
                    class="hover:text-foreground transition">Contacto</a
                >
                <a
                    href="https://instagram.com"
                    target="_blank"
                    rel="noopener"
                    class="hover:text-foreground transition"
                >
                    Instagram
                </a>
            </div>
        </div>
    </div>
</footer>
