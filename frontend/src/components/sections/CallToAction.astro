---
// src/components/sections/CallToAction.astro
import Button from "../ui/Button.astro";
---

<section class="section bg-background fade-on-scroll relative overflow-hidden">
    <div class="wrapper max-w-4xl text-center relative z-10">
        <div
            class="relative overflow-hidden rounded-3xl border border-primary/20 p-10 backdrop-blur-md shadow-2xl shadow-primary/5 sm:p-16"
        >
            <div
                class="absolute inset-0 bg-cover bg-center bg-no-repeat"
                style="background-image: url('/images/CalltoAction.png');"
            >
            </div>

            <div class="absolute inset-0 bg-card/85 backdrop-blur-[2px]"></div>

            <div
                class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"
            >
            </div>
            <div
                class="absolute -left-16 -bottom-16 h-64 w-64 rounded-full bg-primary/5 blur-3xl pointer-events-none"
            >
            </div>

            <div class="relative z-10 flex flex-col items-center">
                <h2
                    class="mt-6 font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl"
                >
                    Tu próximo lavado empieza aquí
                </h2>

                <p
                    class="mt-4 max-w-lg text-sm text-muted-foreground sm:text-base leading-relaxed"
                >
                    Reserva en línea en segundos, elige tu horario ideal y evita
                    las molestas filas de espera.
                </p>

                <div class="mt-8">
                    <Button href="#reservar" variant="primary" size="lg">
                        <span>Reservar con nosotros</span>
                    </Button>
                </div>
            </div>
        </div>
    </div>
</section>
