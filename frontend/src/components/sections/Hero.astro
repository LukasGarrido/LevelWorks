---
import Button from "../ui/Button.astro";
---

<section
    id="hero"
    class="section-full relative justify-center overflow-hidden bg-background fade-on-scroll"
>
    <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/images/hero.png');"
    >
    </div>

    <div class="absolute inset-0 bg-background/80 backdrop-blur-[1px]"></div>

    <div class="wrapper relative z-10 flex flex-col items-start text-left">
        <h1
            class="mt-6 max-w-3xl font-display text-4xl font-bold leading-[1.1] tracking-tight text-foreground sm:text-5xl md:text-6xl"
        >
            Tu auto impecable, <br class="hidden sm:inline" />sin filas ni
            esperas.
        </h1>

        <p
            class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
            Elige tu servicio, reserva un horario disponible y llega justo a tu
            hora. Xperience gestiona todo el resto.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-start gap-3">
            <Button href="#reservar" variant="primary" size="lg">
                <span>Reservar ahora</span>
            </Button>

            <Button href="/admin" variant="secondary" size="lg">
                Panel de administración
            </Button>
        </div>
    </div>
</section>
