---
// src/components/sections/Hero.astro
---

<section
    id="hero"
    class="section-full justify-center bg-background fade-on-scroll"
>
    <div class="wrapper flex flex-col items-start text-left">
        <span
            class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-medium text-primary shadow-sm"
        >
            Autolavado con reserva online
        </span>

        <h1
            class="mt-6 max-w-3xl font-display text-4xl font-bold leading-[1.1] tracking-tight text-foreground sm:text-5xl md:text-6xl"
        >
            Tu auto impecable, <br class="hidden sm:inline" />sin filas ni
            esperas.
        </h1>

        <p
            class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg"
        >
            Elige tu servicio, reserva un horario disponible y llega justo a tu
            hora. Xperience gestiona todo el resto.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-start gap-3">
            <a
                href="#reservar"
                class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
            >
                <span>Reservar ahora</span>
                <span class="text-base leading-none">&rarr;</span>
            </a>

            <a
                href="/admin"
                class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:border-foreground/30 hover:bg-accent"
            >
                Panel de administración
            </a>
        </div>
    </div>
</section>
