---

---

<section id="reservar" class="section bg-background fade-on-scroll">
    <div class="wrapper max-w-3xl">
        <div class="section-head text-center">
            <h2
                class="font-display text-3xl font-bold text-foreground sm:text-4xl"
            >
                Reserva tu cita
            </h2>
        </div>

        <div
            class="space-y-8 rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-sm"
        >
            <!-- Paso 1: Servicio -->
            <div id="step-service">
                <h3
                    class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    1. Selecciona un servicio
                </h3>
                <div id="wizard-service-grid" class="grid gap-3 sm:grid-cols-2">
                    <p class="text-sm text-muted-foreground">
                        Cargando servicios disponibles...
                    </p>
                </div>
            </div>

            <!-- Paso 2: Fecha y hora -->
            <div
                id="step-datetime"
                class="opacity-40 pointer-events-none transition-opacity duration-200 border-t border-border pt-6"
            >
                <h3
                    class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    2. Fecha y hora
                </h3>
                <div class="flex flex-wrap gap-4">
                    <input
                        type="date"
                        id="wizard-date"
                        class="rounded-xl border border-border bg-background px-4 py-2.5 text-foreground focus:border-primary focus:outline-none"
                    />
                    <input
                        type="time"
                        id="wizard-time"
                        class="rounded-xl border border-border bg-background px-4 py-2.5 text-foreground focus:border-primary focus:outline-none"
                    />
                </div>
            </div>

            <!-- Paso 3: Datos del cliente -->
            <div
                id="step-details"
                class="opacity-40 pointer-events-none transition-opacity duration-200 border-t border-border pt-6"
            >
                <h3
                    class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                >
                    3. Tus datos
                </h3>
                <form id="wizard-form" class="space-y-4">
                    <input
                        name="name"
                        type="text"
                        placeholder="Nombre completo"
                        required
                        class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
                    />
                    <input
                        name="email"
                        type="email"
                        placeholder="Correo electrónico"
                        required
                        class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
                    />
                    <input
                        name="phone"
                        type="tel"
                        placeholder="Teléfono"
                        required
                        class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
                    />
                    <input
                        name="vehicle"
                        type="text"
                        placeholder="Modelo de vehículo (opcional)"
                        class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
                    />
                    <textarea
                        name="notes"
                        placeholder="Notas adicionales"
                        rows="3"
                        class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
                    ></textarea>

                    <button
                        type="submit"
                        class="w-full rounded-full bg-primary py-3.5 font-semibold text-primary-foreground transition-opacity hover:opacity-90"
                    >
                        Confirmar reserva
                    </button>
                </form>

                <div
                    id="wizard-result"
                    class="hidden mt-4 rounded-xl p-4 text-center text-sm font-medium"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { getServices, createReservation } from "../../lib/api";
    import type { Service } from "../../lib/types";

    const serviceGrid = document.getElementById("wizard-service-grid")!;
    const stepDatetime = document.getElementById("step-datetime")!;
    const stepDetails = document.getElementById("step-details")!;
    const dateInput = document.getElementById(
        "wizard-date",
    ) as HTMLInputElement;
    const timeInput = document.getElementById(
        "wizard-time",
    ) as HTMLInputElement;
    const form = document.getElementById("wizard-form") as HTMLFormElement;
    const result = document.getElementById("wizard-result")!;

    let selectedServiceId: number | null = null;

    function renderServiceCard(service: Service) {
        const el = document.createElement("article");
        el.className =
            "rounded-xl border border-border bg-background p-4 cursor-pointer transition hover:border-primary/50";
        el.dataset.serviceId = String(service.id);
        el.innerHTML = `
      <h4 class="font-display font-semibold text-foreground">${service.name}</h4>
      <div class="mt-2 flex items-center justify-between">
        <span class="font-bold text-primary">$${service.price.toLocaleString("es-CL")}</span>
        <span class="text-xs text-muted-foreground">${service.duration_minutes} min</span>
      </div>
    `;

        el.addEventListener("click", () => {
            serviceGrid.querySelectorAll("[data-service-id]").forEach((n) => {
                n.classList.remove(
                    "border-primary",
                    "bg-primary/5",
                    "ring-1",
                    "ring-primary",
                );
                n.classList.add("border-border");
            });
            el.classList.add(
                "border-primary",
                "bg-primary/5",
                "ring-1",
                "ring-primary",
            );
            el.classList.remove("border-border");
            selectedServiceId = service.id;
            stepDatetime.classList.remove("opacity-40", "pointer-events-none");
        });

        return el;
    }

    getServices()
        .then((services) => {
            serviceGrid.innerHTML = "";
            services.forEach((s) =>
                serviceGrid.appendChild(renderServiceCard(s)),
            );
        })
        .catch(() => {
            serviceGrid.innerHTML = `<p class="text-sm text-destructive">No se pudieron cargar los servicios.</p>`;
        });

    function checkDatetimeReady() {
        if (dateInput.value && timeInput.value && selectedServiceId) {
            stepDetails.classList.remove("opacity-40", "pointer-events-none");
        }
    }

    dateInput.addEventListener("change", checkDatetimeReady);
    timeInput.addEventListener("change", checkDatetimeReady);

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!selectedServiceId || !dateInput.value || !timeInput.value) return;

        const formData = new FormData(form);
        const scheduledAt = `${dateInput.value}T${timeInput.value}:00`;

        try {
            const reservation = await createReservation({
                client: {
                    name: String(formData.get("name")),
                    email: String(formData.get("email")),
                    phone: String(formData.get("phone")),
                },
                service_id: selectedServiceId,
                scheduled_at: scheduledAt,
                vehicle: String(formData.get("vehicle") || "") || undefined,
                notes: String(formData.get("notes") || "") || undefined,
            });

            form.classList.add("hidden");
            result.classList.remove("hidden");
            result.classList.add(
                "border",
                "border-primary/30",
                "bg-primary/10",
                "text-primary",
            );
            result.textContent = `¡Reserva confirmada! Código #${reservation.id}.`;
        } catch (err) {
            result.classList.remove("hidden");
            result.classList.add(
                "border",
                "border-destructive/30",
                "bg-destructive/10",
                "text-destructive",
            );
            result.textContent =
                err instanceof Error
                    ? err.message
                    : "No se pudo confirmar la reserva.";
        }
    });
</script>
