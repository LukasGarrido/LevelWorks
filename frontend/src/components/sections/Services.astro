---
import { getServices } from "../../lib/api";
import ServiceCard from "../ui/ServiceCard.astro";

let services: Awaited<ReturnType<typeof getServices>> = [];

try {
    services = await getServices();
} catch (err) {
    console.error("[Servicios] Error al obtener catálogo:", err);
}
---

<section id="servicios" class="section bg-background fade-on-scroll">
    <div class="wrapper">
        <div class="section-head text-center">
            <h2
                class="font-display text-3xl font-bold text-foreground sm:text-4xl"
            >
                Nuestros servicios
            </h2>
        </div>

        {
            services.length === 0 ? (
                <div class="rounded-2xl border border-border/50 bg-card/40 p-8 text-center text-sm text-muted-foreground backdrop-blur-md">
                    No hay servicios disponibles en este momento.
                </div>
            ) : (
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {services.map((service) => (
                        <ServiceCard service={service} />
                    ))}
                </div>
            )
        }
    </div>
</section>
