---
const steps = [
    {
        n: "01",
        title: "Elige tu servicio",
        desc: "Selecciona el tipo de lavado que requiere tu vehículo.",
    },
    {
        n: "02",
        title: "Selecciona fecha y hora",
        desc: "Escoge el horario disponible que más te convenga.",
    },
    {
        n: "03",
        title: "Confirma tu reserva",
        desc: "Recibe la confirmación inmediata y llega directo a tu hora.",
    },
];

const infiniteSteps = [...steps, ...steps];
---

<section
    id="como-funciona"
    class="section overflow-hidden bg-secondary/50 fade-on-scroll"
>
    <div class="wrapper">
        <div class="section-head text-center">
            <h2
                class="font-display text-3xl font-bold text-foreground sm:text-4xl"
            >
                Así de simple
            </h2>
        </div>
    </div>

    <div
        class="relative flex w-full overflow-hidden py-4 [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]"
    >
        <div
            class="animate-marquee flex min-w-full shrink-0 items-center justify-around gap-6 hover:[animation-play-state:paused]"
        >
            {
                infiniteSteps.map((s) => (
                    <div class="w-[280px] shrink-0 rounded-2xl border border-border/50 bg-card p-6 text-center shadow-sm sm:w-[320px]">
                        <span class="font-display text-4xl font-extrabold text-primary/40">
                            {s.n}
                        </span>
                        <h3 class="mt-3 font-display text-lg font-semibold text-foreground">
                            {s.title}
                        </h3>
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground sm:text-sm">
                            {s.desc}
                        </p>
                    </div>
                ))
            }
        </div>
        <div
            aria-hidden="true"
            class="animate-marquee flex min-w-full shrink-0 items-center justify-around gap-6 hover:[animation-play-state:paused]"
        >
            {
                infiniteSteps.map((s) => (
                    <div class="w-[280px] shrink-0 rounded-2xl border border-border/50 bg-card p-6 text-center shadow-sm sm:w-[320px]">
                        <span class="font-display text-4xl font-extrabold text-primary/40">
                            {s.n}
                        </span>
                        <h3 class="mt-3 font-display text-lg font-semibold text-foreground">
                            {s.title}
                        </h3>
                        <p class="mt-2 text-xs leading-relaxed text-muted-foreground sm:text-sm">
                            {s.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
