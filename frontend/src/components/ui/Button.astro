---
// src/components/ui/Button.astro
interface Props {
    variant?: "primary" | "secondary" | "ghost";
    size?: "sm" | "md" | "lg";
    href?: string;
    type?: "button" | "submit";
    class?: string;
    [key: string]: any;
}

const {
    variant = "primary",
    size = "md",
    href,
    type = "button",
    class: className = "",
    ...rest
} = Astro.props;

const base =
    "inline-flex items-center justify-center font-medium backdrop-blur-md transition duration-200 disabled:opacity-40 disabled:cursor-not-allowed";

const variants = {
    primary:
        "border border-primary/40 bg-primary/20 text-primary hover:bg-primary/30 hover:border-primary/60 shadow-sm",
    secondary:
        "border border-border/60 bg-card/40 text-foreground hover:bg-card/70 hover:border-border",
    ghost: "text-muted-foreground hover:text-foreground hover:bg-accent/40",
};

/* Tallas reducidas para mayor consistencia */
const sizes = {
    sm: "px-2.5 py-1 text-xs rounded-md",
    md: "px-3.5 py-1.5 text-xs rounded-md",
    lg: "px-4.5 py-2 text-sm rounded-lg",
};

const classes =
    `${base} ${variants[variant]} ${sizes[size]} ${className}`.trim();
const Tag = href ? "a" : "button";
---

<Tag class={classes} href={href} type={!href ? type : undefined} {...rest}>
    <slot />
</Tag>
